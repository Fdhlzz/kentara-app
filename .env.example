# ==============================================================================
# Kentara App Environment Variables Example Template
# Duplicate this file to .env.local and populate with your secure credentials.
# NEVER COMMIT .env or .env.local TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# ------------------------------------------------------------------------------
# Midtrans Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Server key is secret (Keep safe on server only)
MIDTRANS_SERVER_KEY="SB-Mid-server-YOUR_SERVER_KEY"
# Client key is public
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_CLIENT_KEY"
MIDTRANS_MERCHANT_ID="G123456789"
# Set to 'true' for production, 'false' for sandbox
MIDTRANS_IS_PRODUCTION="false"

# ------------------------------------------------------------------------------
# Web Push Notification (VAPID) Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-public-vapid-key"
VAPID_PRIVATE_KEY="your-private-vapid-key"
VAPID_SUBJECT="mailto:admin@kentara.id"

# ------------------------------------------------------------------------------
# Application Environment & Base URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
